// ── 自举模块 2：parser（独立，只提供 parseExpr）──
// 纯自递归优先级爬升：parseExpr 只调自己，原子解析内联，不依赖其他函数。
// 这样免语言闭包快照下函数不会互相看不见（A 只调 A，自递归）。
// 优先级：* / = 2，+ - = 1，括号递归下降。

// 运算符优先级：乘除=4，加减=3，比较=2，逻辑与=1，逻辑或=0，非运算符=-1
// token 名对照 self_lexer：== EQ_EQ, != BANG_EQ, < LT, <= LT_EQ, > GT, >= GT_EQ, && AMPS, || PIPES
fun precOf(tok) {
  done tok["type"] == "STAR" { return 4; }
  done tok["type"] == "SLASH" { return 4; }
  done tok["type"] == "PLUS" { return 3; }
  done tok["type"] == "MINUS" { return 3; }
  done tok["type"] == "EQ_EQ" { return 2; }
  done tok["type"] == "BANG_EQ" { return 2; }
  done tok["type"] == "LT" { return 2; }
  done tok["type"] == "LT_EQ" { return 2; }
  done tok["type"] == "GT" { return 2; }
  done tok["type"] == "GT_EQ" { return 2; }
  done tok["type"] == "AMPS" { return 1; }
  done tok["type"] == "PIPES" { return 0; }
  return -1;
}

// 优先级爬升：唯一递归函数，原子解析内联（if/else if 链）
fun parseExpr(toks, i, minPrec) {
  // ── 原子（内联解析：数字 / 变量 / 函数调用 / 括号）──
  let atom = { "kind": "num", "value": 0 };
  let acur = i;
  if (i < len(toks)) {
    let t = toks[i];
    if (t["type"] == "NUMBER") {
      atom = { "kind": "num", "value": num(t["lexeme"]) };
      acur = i + 1;
    } else if (t["type"] == "STRING") {
      // 字符串字面量：lexeme 带引号，剥掉两侧引号
      let lit = t["lexeme"];
      atom = { "kind": "str", "value": sub(lit, 1, len(lit) - 1) };
      acur = i + 1;
    } else if (t["type"] == "TRUE") {
      atom = { "kind": "bool", "value": true };   // 真布尔，不是数字 1
      acur = i + 1;
    } else if (t["type"] == "FALSE") {
      atom = { "kind": "bool", "value": false };   // 假布尔，不是数字 0
      acur = i + 1;
    } else if (t["type"] == "IDENT" && i + 1 < len(toks) && toks[i+1]["type"] == "LPAREN") {
      // 函数调用：name( arg, arg, ... )
      let name = t["lexeme"];
      let args = [];
      let cur = i + 2;   // 跳过 ( 
      if (cur < len(toks) && toks[cur]["type"] != "RPAREN") {
        // 至少一个参数
        let first = parseExpr(toks, cur, 0);
        args = append(args, first["ast"]);
        cur = first["cur"];
        while (cur < len(toks) && toks[cur]["type"] == "COMMA") {
          let nxt = parseExpr(toks, cur + 1, 0);
          args = append(args, nxt["ast"]);
          cur = nxt["cur"];
        }
      }
      atom = { "kind": "call", "name": name, "args": args };
      acur = cur + 1;   // 跳过 )
    } else if (t["type"] == "LBRACKET") {
      // 数组字面量：[ e1, e2, ... ]
      let items = [];
      let cur = i + 1;   // 跳过 [
      if (cur < len(toks) && toks[cur]["type"] != "RBRACKET") {
        let first = parseExpr(toks, cur, 0);
        items = append(items, first["ast"]);
        cur = first["cur"];
        while (cur < len(toks) && toks[cur]["type"] == "COMMA") {
          let nxt = parseExpr(toks, cur + 1, 0);
          items = append(items, nxt["ast"]);
          cur = nxt["cur"];
        }
      }
      atom = { "kind": "array", "items": items };
      acur = cur + 1;   // 跳过 ]
    } else if (t["type"] == "LBRACE") {
      // 字典字面量：{ "key": value, ... }
      let entries = [];
      let cur = i + 1;   // 跳过 {
      while (cur < len(toks) && toks[cur]["type"] != "RBRACE") {
        // 键：字符串或标识符
        let key = "";
        if (toks[cur]["type"] == "STRING") {
          let lit = toks[cur]["lexeme"];
          key = sub(lit, 1, len(lit) - 1);
        } else {
          key = toks[cur]["lexeme"];
        }
        cur = cur + 1;   // 跳到 :
        if (cur < len(toks) && toks[cur]["type"] == "COLON") { cur = cur + 1; }
        let v = parseExpr(toks, cur, 0);
        entries = append(entries, { "key": key, "value": v["ast"] });
        cur = v["cur"];
        if (cur < len(toks) && toks[cur]["type"] == "COMMA") { cur = cur + 1; }
      }
      atom = { "kind": "dict", "entries": entries };
      acur = cur + 1;   // 跳过 }
    } else if (t["type"] == "IDENT") {
      atom = { "kind": "var", "name": t["lexeme"] };
      acur = i + 1;
    } else if (t["type"] == "LPAREN") {
      let inner = parseExpr(toks, i + 1, 0);
      atom = inner["ast"];
      acur = inner["cur"] + 1;
    }
  }

  let ast = atom;
  let cur = acur;
  // 后缀索引：atom[索引] → { kind:"index", callee, index }
  while (cur < len(toks) && toks[cur]["type"] == "LBRACKET") {
    let idx = parseExpr(toks, cur + 1, 0);
    ast = { "kind": "index", "callee": ast, "index": idx["ast"] };
    cur = idx["cur"] + 1;   // 跳过 ]
  }
  // 赋值：var = value（右结合）——只有 atom 是变量才能赋值
  if (atom["kind"] == "var" && cur < len(toks) && toks[cur]["type"] == "EQ") {
    let v = parseExpr(toks, cur + 1, 0);
    return { "ast": { "kind": "assign", "name": atom["name"], "value": v["ast"] }, "cur": v["cur"] };
  }
  let goon = 1;
  while (goon == 1 && cur < len(toks)) {
    let p = precOf(toks[cur]);
    if (p < minPrec) { goon = 0; }
    else {
      let op = toks[cur];
      let right = parseExpr(toks, cur + 1, p + 1);
      ast = { "kind": "bin", "op": op["lexeme"], "left": ast, "right": right["ast"] };
      cur = right["cur"];
    }
  }
  return { "ast": ast, "cur": cur };
}

// 语句序列解析：处理一个"块"里的语句（到 RBRACE 为止）
// 处理：; / return / let / print / while / if(含 else if 链) / 赋值 / 表达式
fun parseBlock(toks, i) {
  let stmts = [];
  let b = i;
  while (b < len(toks) && toks[b]["type"] != "RBRACE") {
    if (toks[b]["type"] == "SEMI") { b = b + 1; }
    else if (toks[b]["type"] == "RETURN") {
      let rv = parseExpr(toks, b + 1, 0);
      stmts = append(stmts, { "kind": "return", "value": rv["ast"] });
      b = rv["cur"];
      if (b < len(toks) && toks[b]["type"] == "SEMI") { b = b + 1; }
    }
    else if (toks[b]["type"] == "LET") {
      let nm = toks[b + 1]["lexeme"];
      let lv = parseExpr(toks, b + 3, 0);
      stmts = append(stmts, { "kind": "let", "name": nm, "value": lv["ast"] });
      b = lv["cur"];
      if (b < len(toks) && toks[b]["type"] == "SEMI") { b = b + 1; }
    }
    else if (toks[b]["type"] == "PRINT") {
      let pv = parseExpr(toks, b + 1, 0);
      stmts = append(stmts, { "kind": "print", "value": pv["ast"] });
      b = pv["cur"];
      if (b < len(toks) && toks[b]["type"] == "SEMI") { b = b + 1; }
    }
    else if (toks[b]["type"] == "WHILE") {
      let condStart = b + 2;
      let cond = parseExpr(toks, condStart, 0);
      let wb = cond["cur"];
      if (wb < len(toks) && toks[wb]["type"] == "RPAREN") { wb = wb + 1; }
      if (wb < len(toks) && toks[wb]["type"] == "LBRACE") { wb = wb + 1; }
      let wres = parseBlock(toks, wb);
      stmts = append(stmts, { "kind": "while", "condition": cond["ast"], "body": wres["stmts"] });
      b = wres["cur"] + 1;
    }
    else if (toks[b]["type"] == "IF") {
      // if 链（含 else if）
      let ifchain = 0;
      let iftail = 0;
      let wif = b;
      while (wif < len(toks) && toks[wif]["type"] == "IF") {
        let wcond = parseExpr(toks, wif + 1, 0);
        let wib = wcond["cur"];
        if (wib < len(toks) && toks[wib]["type"] == "RPAREN") { wib = wib + 1; }
        if (wib < len(toks) && toks[wib]["type"] == "LBRACE") { wib = wib + 1; }
        let wthen = parseBlock(toks, wib);
        wib = wthen["cur"];
        if (wib < len(toks) && toks[wib]["type"] == "RBRACE") { wib = wib + 1; }
        let newif = { "kind": "if", "condition": wcond["ast"], "then": { "kind": "block", "stmts": wthen["stmts"] }, "else": { "kind": "num", "value": 0 } };
        if (ifchain == 0) { ifchain = newif; } else { iftail["else"] = newif; }
        iftail = newif;
        if (wib < len(toks) && toks[wib]["type"] == "ELSE") {
          wib = wib + 1;
          if (wib < len(toks) && toks[wib]["type"] == "IF") {
            wif = wib;
          } else if (wib < len(toks) && toks[wib]["type"] == "LBRACE") {
            wib = wib + 1;
            let weres = parseBlock(toks, wib);
            iftail["else"] = { "kind": "block", "stmts": weres["stmts"] };
            wib = weres["cur"];
            if (wib < len(toks) && toks[wib]["type"] == "RBRACE") { wib = wib + 1; }
            break;
          } else {
            break;
          }
        } else {
          break;
        }
      }
      stmts = append(stmts, ifchain);
      b = wib;
    }
    else {
      let e = parseExpr(toks, b, 0);
      stmts = append(stmts, e["ast"]);
      b = e["cur"];
    }
  }
  return { "stmts": stmts, "cur": b };
}

// 解析程序：fun 定义 或 表达式，返回语句数组
// fun name(param, param){ body } → { kind:"fun", name, params, body }
fun parseProgram(toks, i) {
  let stmts = [];
  let cur = i;
  while (cur < len(toks)) {
    if (toks[cur]["type"] == "FUN") {
      // fun 定义
      let name = toks[cur + 1]["lexeme"];
      let p = cur + 3;   // 跳过 fun name (
      let params = [];
      if (toks[p]["type"] != "RPAREN") {
        params = append(params, toks[p]["lexeme"]);
        p = p + 1;
        while (toks[p]["type"] == "COMMA") {
          params = append(params, toks[p + 1]["lexeme"]);
          p = p + 2;
        }
      }
      // p 现在指向 )，跳过它到 {
      let b = p + 2;   // 跳过 ) {
      let bres = parseBlock(toks, b);
      stmts = append(stmts, { "kind": "fun", "name": name, "params": params, "body": bres["stmts"] });
      cur = bres["cur"] + 1;   // 跳过 }
    } else if (toks[cur]["type"] == "LET") {
      // let 声明：let name = value;
      let name = toks[cur + 1]["lexeme"];
      let eq = cur + 2;   // 跳过 name =  → 实际指向 =
      // eq 应在 = 处，值从 eq+1 开始
      let v = parseExpr(toks, eq + 1, 0);
      stmts = append(stmts, { "kind": "let", "name": name, "value": v["ast"] });
      cur = v["cur"];
      // 跳过 ;
      if (cur < len(toks) && toks[cur]["type"] == "SEMI") { cur = cur + 1; }
    } else if (toks[cur]["type"] == "PRINT") {
      // print 语句：print value;
      let v = parseExpr(toks, cur + 1, 0);
      stmts = append(stmts, { "kind": "print", "value": v["ast"] });
      cur = v["cur"];
      if (cur < len(toks) && toks[cur]["type"] == "SEMI") { cur = cur + 1; }
    } else if (toks[cur]["type"] == "IF") {
      // if 语句：if condition { thenBranch } else { elseBranch }
      let cond = parseExpr(toks, cur + 1, 0);   // 跳过 if
      let b = cond["cur"];
      // 跳过 { 前的 )
      if (b < len(toks) && toks[b]["type"] == "RPAREN") { b = b + 1; }
      if (b < len(toks) && toks[b]["type"] == "LBRACE") { b = b + 1; }
      // 解析 then 分支（单表达式）
      let thenBody = parseExpr(toks, b, 0);
      b = thenBody["cur"];
      if (b < len(toks) && toks[b]["type"] == "RBRACE") { b = b + 1; }
      // 解析 else 分支（如果有）
      let elseBody = { "kind": "num", "value": 0 };
      if (b < len(toks) && toks[b]["type"] == "ELSE") {
        if (b + 1 < len(toks) && toks[b+1]["type"] == "LBRACE") { b = b + 2; }
        let eb = parseExpr(toks, b, 0);
        elseBody = eb["ast"];
        b = eb["cur"];
        if (b < len(toks) && toks[b]["type"] == "RBRACE") { b = b + 1; }
      }
      stmts = append(stmts, { "kind": "if", "condition": cond["ast"], "then": thenBody["ast"], "else": elseBody });
      cur = b;
    } else if (toks[cur]["type"] == "WHILE") {
      // while 循环：while ( condition ) { body }
      // self_lexer: while ( cond ) { stmts } → tokens: WHILE LPAREN ... RPAREN LBRACE ... RBRACE
      let condStart = cur + 2;   // 跳过 while (
      let cond = parseExpr(toks, condStart, 0);   // 条件：minPrec=1，遇 ) 停（prec0）
      // 现在 cur 指向 ) 之后，应到 { 
      let b = cond["cur"];
      if (b < len(toks) && toks[b]["type"] == "RPAREN") { b = b + 1; }
      if (b < len(toks) && toks[b]["type"] == "LBRACE") { b = b + 1; }
      let body = [];
      while (b < len(toks) && toks[b]["type"] != "RBRACE") {
        if (toks[b]["type"] == "SEMI") { b = b + 1; }
        else if (toks[b]["type"] == "PRINT") {
          // body 里 print：print value;
          let pv = parseExpr(toks, b + 1, 0);
          body = append(body, { "kind": "print", "value": pv["ast"] });
          b = pv["cur"];
          if (b < len(toks) && toks[b]["type"] == "SEMI") { b = b + 1; }
        } else if (toks[b]["type"] == "LET") {
          // body 里 let：let name = value;
          let nm = toks[b + 1]["lexeme"];
          let lv = parseExpr(toks, b + 3, 0);
          body = append(body, { "kind": "let", "name": nm, "value": lv["ast"] });
          b = lv["cur"];
          if (b < len(toks) && toks[b]["type"] == "SEMI") { b = b + 1; }
        } else {
          let e = parseExpr(toks, b, 0);
          body = append(body, e["ast"]);
          b = e["cur"];
        }
      }
      stmts = append(stmts, { "kind": "while", "condition": cond["ast"], "body": body });
      cur = b + 1;   // 跳过 }
    } else if (toks[cur]["type"] == "SEMI") {
      cur = cur + 1;
    } else {
      let e = parseExpr(toks, cur, 0);
      stmts = append(stmts, e["ast"]);
      cur = e["cur"];
    }
  }
  return stmts;
}
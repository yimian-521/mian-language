// ── 自举模块 3：eval（独立，只提供 evalMian）──
// 自递归求值：num / bin / var / call。环境用字典 + ref+write 绑定参数。

fun evalMian(node, env) {
  let kind = node["kind"];
  // 数字字面量
  done kind == "num" { return node["value"]; }
  // 字符串字面量
  done kind == "str" { return node["value"]; }
  // 布尔字面量
  done kind == "bool" { return node["value"]; }
  // 二元运算（含比较）
  done kind == "bin" {
    let op = node["op"];
    // && / || 短路：先求左，短路时不求右（避免 i<n && isDigit(src[i]) 里 src[i] 越界）
    done op == "&&" {
      let l = evalMian(node["left"], env);
      done l == false { return false; }
      return evalMian(node["right"], env);
    }
    done op == "||" {
      let l = evalMian(node["left"], env);
      done l != false { return true; }
      return evalMian(node["right"], env);
    }
    let l = evalMian(node["left"], env);
    let r = evalMian(node["right"], env);
    done op == "+" { return l + r; }
    done op == "-" { return l - r; }
    done op == "*" { return l * r; }
    done op == "/" { return l / r; }
    done op == "==" { return l == r; }
    done op == "===" { return l == r; }
    done op == "!=" { return l != r; }
    done op == ">" { return l > r; }
    done op == "<" { return l < r; }
    done op == ">=" { return l >= r; }
    done op == "<=" { return l <= r; }
    done op == "&&" { return l && r; }
    done op == "||" { return l || r; }
    return 0;
  }
  // 数组字面量：{ kind:"array", items } → 逐项求值返回数组
  done kind == "array" {
    let out = [];
    let i = 0;
    while (i < len(node["items"])) {
      out = append(out, evalMian(node["items"][i], env));
      i = i + 1;
    }
    return out;
  }
  // 字典字面量：{ kind:"dict", entries:[{key,value}] } → 建字典
  done kind == "dict" {
    let d = {};
    let i = 0;
    while (i < len(node["entries"])) {
      let e = node["entries"][i];
      let slot = ref d[e["key"]];
      write(slot, evalMian(e["value"], env));
      i = i + 1;
    }
    return d;
  }
  // 索引访问：{ kind:"index", callee, index } → 数组/字典取元素
  done kind == "index" {
    let target = evalMian(node["callee"], env);
    let idx = evalMian(node["index"], env);
    return target[idx];
  }
  // 变量读取
  done kind == "var" { return get(env, node["name"], 0); }
  // let 声明：{ kind:"let", name, value } → 存环境
  done kind == "let" {
    let v = evalMian(node["value"], env);
    let slot = ref env[node["name"]];
    write(slot, v);
    return v;
  }
  // 赋值：{ kind:"assign", name, value } → 改环境
  done kind == "assign" {
    let v = evalMian(node["value"], env);
    let slot = ref env[node["name"]];
    write(slot, v);
    return v;
  }
  // print：{ kind:"print", value } → 输出并返回（这里直接返回求值结果，输出由宿主/主程序收集）
  done kind == "print" {
    return evalMian(node["value"], env);
  }
  // if/else：{ kind:"if", condition, then, else }
  done kind == "if" {
    let c = evalMian(node["condition"], env);
    if (c) {
      return evalMian(node["then"], env);
    } else {
      return evalMian(node["else"], env);
    }
  }
  // done 定性：{ kind:"done", condition, body } —— 只执行，返回最后一条
  done kind == "done" {
    let c = evalMian(node["condition"], env);
    done c != false {   // 条件求值返回布尔：false 才不执行（不能用 != 0，严格类型）
      let j = 0;
      let last = 0;
      while (j < len(node["body"])) {
        last = evalMian(node["body"][j], env);
        j = j + 1;
      }
      return last;
    }
    return 0;
  }
  // while 循环：{ kind:"while", condition, body }
  done kind == "while" {
    let last = 0;
    let c = evalMian(node["condition"], env);
    while (c != false) {   // 条件求值返回布尔：false 才停（不能用 != 0，布尔vs数字严格类型恒真）
      // body 循环内联（避免 evalBody 与 evalMian 互相引用导致的闭包快照问题）
      let j = 0;
      while (j < len(node["body"])) {
        last = evalMian(node["body"][j], env);
        j = j + 1;
      }
      c = evalMian(node["condition"], env);
    }
    return last;
  }
  // 语句序列（block）：{ kind:"block", stmts } → 逐条执行，返回最后一条
  done kind == "block" {
    let j = 0;
    let last = 0;
    while (j < len(node["stmts"])) {
      last = evalMian(node["stmts"][j], env);
      j = j + 1;
    }
    return last;
  }
  // 函数定义：fun name(params){body} → 存入环境
  done kind == "fun" {
    // 闭包快照：浅拷贝当前 env（冻结"定义时"环境，避免循环引用 + 动态作用域泄漏）
    let closure = {};
    let cks = dictKeys(env);
    let ci = 0;
    while (ci < len(cks)) {
      let ck = cks[ci];
      let cslot = ref closure[ck];
      write(cslot, env[ck]);
      ci = ci + 1;
    }
    let fn = { "params": node["params"], "body": node["body"], "closure": closure };
    let slot = ref env[node["name"]];
    write(slot, fn);
    return node["name"];
  }
  // 函数调用：{ kind:"call", name, args } → 按名字从环境查函数体
  done kind == "call" {
    let fn = env[node["name"]];
    // 原生函数（宿主 stdlib 如 len/chr）：直接调用，不是字典 {params,body}
    done type(fn) == "function" {
      let nargs = len(node["args"]);
      done nargs == 1 {
        let a0 = evalMian(node["args"][0], env);
        return fn(a0);
      }
      done nargs == 2 {
        let a0 = evalMian(node["args"][0], env);
        let a1 = evalMian(node["args"][1], env);
        return fn(a0, a1);
      }
      done nargs == 3 {
        let a0 = evalMian(node["args"][0], env);
        let a1 = evalMian(node["args"][1], env);
        let a2 = evalMian(node["args"][2], env);
        return fn(a0, a1, a2);
      }
      return 0;
    }
    let child = {};
    // 闭包（拷贝式）：从"定义时环境"closure 拷贝，不是调用时环境（避免把局部变量也拷进去，语义对 + 快）
    let clos = get(fn, "closure", env);
    let ks = dictKeys(clos);
    let ki = 0;
    while (ki < len(ks)) {
      let k = ks[ki];
      let kslot = ref child[k];
      write(kslot, clos[k]);
      ki = ki + 1;
    }
    let i = 0;
    while (i < len(fn["params"])) {
      let pn = fn["params"][i];
      let pv = evalMian(node["args"][i], env);
      let slot = ref child[pn];
      write(slot, pv);
      i = i + 1;
    }
    let j = 0;
    let last = 0;
    while (j < len(fn["body"])) {
      last = evalMian(fn["body"][j], child);
      // return 截断信号：先判断 last 是字典（type=="object"）再 get，避免对数字 get 报错
      done type(last) == "object" {
        let rv = get(last, "__ret__", 0);
        done rv != 0 {
          return rv;
        }
      }
      j = j + 1;
    }
    return last;
  }
  // return 语句：{ kind:"return", value } → 返回 { __ret__: 值 } 作为截断信号
  done kind == "return" {
    let v = evalMian(node["value"], env);
    return { "__ret__": v };
  }
  return 0;
}

// 求值语句列表（body 是数组），返回最后一条
fun evalBody(body, env) {
  let i = 0;
  let last = 0;
  while (i < len(body)) {
    last = evalMian(body[i], env);
    i = i + 1;
  }
  return last;
}
import "boot_eval.mi"; let env = {}; let w = { "kind": "while", "condition": { "kind": "bin", "op": "<", "left": { "kind": "var", "name": "i" }, "right": { "kind": "num", "value": 3 } }, "body": [ { "kind": "assign", "name": "i", "value": { "kind": "bin", "op": "+", "left": { "kind": "var", "name": "i" }, "right": { "kind": "num", "value": 1 } } } ] }; let ix = { "kind": "let", "name": "i", "value": { "kind": "num", "value": 0 } }; evalMian(ix, env); print "before=" + str(env["i"]); evalMian(w, env); print "after=" + str(env["i"]);
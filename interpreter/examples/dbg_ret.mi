import "boot_lex.mi"; import "boot_parse.mi"; let source = "fun f() { return 99; return 88; } f()"; let toks = lexMian(source); print "tok=" + str(len(toks)); let stmts = parseProgram(toks, 0); print "stmt=" + str(len(stmts)); let k = 0; while (k < len(stmts)) { print "st" + str(k) + "=" + stmts[k]["kind"]; k = k + 1; }
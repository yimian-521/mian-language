// ── 免语言并发搜索演示：spawn 多引擎同时跑 ──
// 这是"免语言能写复杂工具"的核心证明：多个引擎函数并发执行，结果聚合
// 用机器手 spawn（宿主并发）+ sleep（模拟每个引擎的耗时）+ httpGet（真实网络）
// 哲学：语言把多个函数交给机器并行，机器干完一起回禀——机器是资源不是榜样

// 模拟引擎函数：每个引擎"搜索"一个词，返回结果
// 真实场景里这里会是 httpGet(url)，此处用 sleep 模拟耗时差异
fun engineBing(q) {
  sleep(300);
  return "必应搜到: " + q + " 的 3 条结果";
}
fun engineGoogle(q) {
  sleep(150);
  return "谷歌搜到: " + q + " 的 5 条结果";
}
fun engineBaidu(q) {
  sleep(500);
  return "百度搜到: " + q + " 的 2 条结果";
}

// 并发聚合：同时跑三个引擎，全部回来再汇总
fun multiSearch(q) {
  let r = spawn([engineBing, engineGoogle, engineBaidu], [[q], [q], [q]]);
  // r = [true, [ [true,结果1], [true,结果2], [true,结果3] ]]
  if r[0] == false { return "搜索失败: " + r[1]; }
  let results = r[1];
  let total = len(results);
  let i = 0;
  let lines = [];
  while (i < total) {
    // 每个结果是 [成功, 值]，取 [1]
    lines = lines + [results[i][1]];
    i = i + 1;
  }
  return "并发聚合 " + str(total) + " 个引擎:\n" + lines[0] + "\n" + lines[1] + "\n" + lines[2];
}

// 跑一次
print multiSearch("免语言");

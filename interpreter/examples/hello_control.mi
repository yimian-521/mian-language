// ── 控制权最小证明：语言定事实，机器只是执行者 ──
// 哲学：不是模仿处理器，是让处理器为我们所用。
// 这个脚本里，每一句都在展示"谁在决策，谁在照办"。

// 语言写下事实（机器没有发言权，只有计算义务）
let fact = 1 + 2;

// 语言裁决——done 定性：这就是事实，直接认定
done fact == 3 { print "语言裁决：3 是事实，机器照办。"; }

// 语言调用机器能力（clock 是宿主手，语言只需要时间，不在乎宿主是谁）
let t = clock();
print "机器提供了时间，但决定做什么的是语言。";

// 同一份语言，换任何执行者，结论不变——这是控制权的验收
done fact == 3 { print "控制权验收：事实不随机器变。"; }